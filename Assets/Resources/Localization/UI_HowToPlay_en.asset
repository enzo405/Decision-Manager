  m_TableData:
  - m_Id: 320271331328
    m_Localized: How to play
    m_Metadata:
      m_Items: []
  - m_Id: 320292302848
    m_Localized: "<b>Objective</b>\nKeep your team balanced over 12 weeks.\n\n<b>Each
      turn</b>\nChoose one card from 3 available decisions. Each card has a success
      probability and affects your 4 stats.\n\n<b>Stats</b>\n\u2022 Motivation \u2014
      team engagement\n\u2022 Stress \u2014 pressure felt by the team\n\u2022 Performance
      \u2014 overall productivity\n\u2022 Turnover \u2014 risk of team members leaving\n\n<b>Defeat
      if...</b>\n\u2022 Stress gets too high (burnout)\n\u2022 Turnover is out of
      control\n\u2022 Performance drops too low\n\n<b>Victory</b>\nSurvive 12 weeks
      while keeping the team balanced."
    m_Metadata:
      m_Items: []
  references:
    version: 2
